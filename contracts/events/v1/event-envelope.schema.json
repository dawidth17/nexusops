{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusops.dev/contracts/events/v1/event-envelope.schema.json",
  "title": "NexusOps Event Envelope v1",
  "description": "Common envelope for version 1 NexusOps domain events.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "source",
    "correlationId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "$ref": "#/$defs/uuid"
    },
    "eventType": {
      "type": "string",
      "pattern": "^nexusops\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 200
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 64
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "payload": {
      "type": "object",
      "minProperties": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}